generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum RegistrationStatus {
  PENDING
  WAITLISTED
  AWAITING_CONFIRMATION
  CONFIRMED
  DECLINED
  CANCELLED
  LATE_CANCELLATION
  NOT_SELECTED
  REJECTED
  EXPIRED
  NO_CHECK_IN
  EXCUSED
}

enum EventStatus {
  DRAFT     @map("draft")
  PUBLISHED @map("published")
  COMPLETED @map("completed")
  CANCELLED @map("cancelled")
}

enum QuestionType {
  TEXT     @map("text")
  SELECT   @map("select")
  RADIO    @map("radio")
  CHECKBOX @map("checkbox")
}

enum BlacklistReason {
  CONFIRMATION_EXPIRED
  LATE_CANCELLATION
  NO_CHECK_IN
}

enum MembershipRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MembershipCommitteeDecision {
  PENDING
  APPROVED
  REJECTED
}

enum AnnouncementCategory {
  events
  recruitment
  workshops
  results
  community
  trip
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
}

model Person {
  personId        Int      @id @default(autoincrement()) @map("person_id")
  authUserId      String?  @unique @map("auth_user_id") @db.Uuid
  fullName        String   @map("full_name") @db.VarChar(255)
  emailUniversity String?  @map("email_university") @db.VarChar(255)
  emailPersonal   String?  @map("email_personal") @db.VarChar(255)
  emailPersonalVerifiedAt DateTime? @map("email_personal_verified_at") @db.Timestamptz(6)
  emailUniversityVerifiedAt DateTime? @map("email_university_verified_at") @db.Timestamptz(6)
  phoneNumber     String?  @map("phone_number") @db.VarChar(50)
  university      String?  @db.VarChar(255)
  branch          String?  @db.VarChar(100)
  major           String?  @db.VarChar(255)
  gender          String?  @db.VarChar(20)
  profileImageUrl String?  @map("profile_image_url") @db.Text
  bio             String?  @db.VarChar(1000)
  githubUrl       String?  @map("github_url") @db.VarChar(2048)
  portfolioUrl    String?  @map("portfolio_url") @db.VarChar(2048)
  xUrl            String?  @map("x_url") @db.VarChar(2048)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  member        Member?
  registrations EventRegistration[] @relation("RegistrationOwner")
  membershipRequest MembershipRequest?
  nonMemberRegistration NonMemberRegistration?
  emailVerificationChallenges EmailVerificationChallenge[]
  pendingSignup PendingSignup?
  emailIdentities PersonEmailIdentity[]

  @@map("person")
}

model Role {
  roleCode     String  @id @map("role_code") @db.Text
  description  String? @db.Text
  isPrivileged Boolean @default(true) @map("is_privileged")

  permissions RolePermission[]
  members     MemberRole[]
  membershipRequestGlobalRoles MembershipRequestGlobalRole[]

  @@map("role")
}

model Permission {
  code            String  @id @db.Text
  description     String  @db.Text
  scope           String  @db.Text
  grantPermission String? @map("grant_permission") @db.Text
  isSensitive     Boolean @default(false) @map("is_sensitive")

  grant      Permission?           @relation("PermissionGrantRequirement", fields: [grantPermission], references: [code], onDelete: NoAction, onUpdate: NoAction)
  grants     Permission[]          @relation("PermissionGrantRequirement")
  roles      RolePermission[]
  committees CommitteePermission[]

  @@map("permission")
}

model RolePermission {
  roleCode String @map("role_code") @db.Text
  code     String @db.Text

  role       Role       @relation(fields: [roleCode], references: [roleCode], onDelete: Restrict, onUpdate: NoAction)
  permission Permission @relation(fields: [code], references: [code], onDelete: Restrict, onUpdate: NoAction)

  @@id([roleCode, code])
  @@index([code])
  @@map("role_permission")
}

model Member {
  memberId   Int       @id @default(autoincrement()) @map("member_id")
  personId   Int       @unique @map("person_id")
  memberType String    @default("current") @map("member_type") @db.Text
  joinDate   DateTime? @map("join_date") @db.Date
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  person                   Person                       @relation(fields: [personId], references: [personId], onDelete: Restrict, onUpdate: NoAction)
  roleAssignments          MemberRole[]                 @relation("MemberRoleRecipient")
  assignedRoles            MemberRole[]                 @relation("MemberRoleAssigner")
  skills                   MemberSkill[]
  committees               MemberCommittee[]
  createdEvents            Event[]                      @relation("EventCreator")
  reviewedRegistrations    EventRegistration[]          @relation("RegistrationReviewer")
  checkedInRegistrations   EventRegistration[]          @relation("RegistrationCheckInStaff")
  excusedRegistrations     EventRegistration[]          @relation("RegistrationExcuseStaff")
  resolvedBlacklistEntries RegistrationBlacklistEntry[] @relation("BlacklistResolver")
  reviewedMembershipCommittees MembershipRequestCommittee[] @relation("MembershipDecisionReviewer")
  reviewedGlobalMembershipRoles MembershipRequestGlobalRole[] @relation("GlobalRoleDecisionReviewer")
  publishedAnnouncements Announcement[]

  @@map("member")
}

model Skill {
  skillId   Int    @id @default(autoincrement()) @map("skill_id")
  skillName String @unique @map("skill_name") @db.VarChar(255)

  members MemberSkill[]

  @@map("skill")
}

model MemberSkill {
  id       Int @id @default(autoincrement())
  memberId Int @map("member_id")
  skillId  Int @map("skill_id")

  member Member @relation(fields: [memberId], references: [memberId], onDelete: Restrict, onUpdate: NoAction)
  skill  Skill  @relation(fields: [skillId], references: [skillId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([memberId, skillId])
  @@index([skillId])
  @@map("member_skill")
}

model MemberRole {
  id         Int       @id @default(autoincrement())
  memberId   Int       @map("member_id")
  roleCode   String    @map("role_code") @db.Text
  startsOn   DateTime? @map("starts_on") @db.Date
  endsOn     DateTime? @map("ends_on") @db.Date
  assignedBy Int?      @map("assigned_by")
  notes      String?   @db.VarChar(500)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  member   Member  @relation("MemberRoleRecipient", fields: [memberId], references: [memberId], onDelete: Restrict, onUpdate: NoAction)
  role     Role    @relation(fields: [roleCode], references: [roleCode], onDelete: Restrict, onUpdate: NoAction)
  assigner Member? @relation("MemberRoleAssigner", fields: [assignedBy], references: [memberId], onDelete: Restrict, onUpdate: NoAction)

  // SQL migration enforces date order and partial indexes WHERE ends_on IS NULL.
  // A full Prisma @@unique would incorrectly reject repeated ended assignments.
  @@map("member_role")
}

model Committee {
  committeeId       Int    @id @default(autoincrement()) @map("committee_id")
  committeeName     String @unique @map("committee_name") @db.VarChar(255)
  committeeCode     String @unique @map("committee_code") @db.VarChar(20)
  parentCommitteeId Int?   @map("parent_committee_id")

  parent      Committee?            @relation("CommitteeHierarchy", fields: [parentCommitteeId], references: [committeeId], onDelete: Restrict, onUpdate: NoAction)
  children    Committee[]           @relation("CommitteeHierarchy")
  members     MemberCommittee[]
  events      Event[]
  permissions CommitteePermission[]
  membershipRequests MembershipRequestCommittee[]
  tasks       CommitteeTask[]

  @@index([parentCommitteeId])
  @@map("committee")
}

model CommitteePermission {
  id                   Int     @id @default(autoincrement())
  committeeId          Int?    @map("committee_id")
  committeeRole        String  @map("committee_role") @db.Text
  code                 String  @db.Text
  appliesTo            String  @map("applies_to") @db.Text
  includeSubCommittees Boolean @default(false) @map("include_sub_committees")

  committee  Committee? @relation(fields: [committeeId], references: [committeeId], onDelete: Restrict, onUpdate: NoAction)
  permission Permission @relation(fields: [code], references: [code], onDelete: Restrict, onUpdate: NoAction)

  // SQL enforces role/scope checks and COALESCE(committee_id, 0) uniqueness.
  @@index([committeeId, committeeRole], map: "committee_permission_committee_role_idx")
  @@index([code], map: "committee_permission_code_idx")
  @@map("committee_permission")
}

model MemberCommittee {
  id          Int      @id @default(autoincrement())
  memberId    Int      @map("member_id")
  committeeId Int      @map("committee_id")
  role        String   @default("Member") @db.VarChar(100)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  member    Member    @relation(fields: [memberId], references: [memberId], onDelete: Restrict, onUpdate: NoAction)
  committee Committee @relation(fields: [committeeId], references: [committeeId], onDelete: Restrict, onUpdate: NoAction)
  assignedTasks CommitteeTask[] @relation("TaskAssignee")
  createdTasks  CommitteeTask[] @relation("TaskCreator")
  pointsReceived CommitteePointEntry[] @relation("PointsRecipient")
  pointsAwarded  CommitteePointEntry[] @relation("PointsAwarder")

  @@unique([memberId, committeeId])
  @@index([committeeId])
  @@map("member_committee")
}

model MembershipRequest {
  membershipRequestId Int                     @id @default(autoincrement()) @map("membership_request_id")
  personId            Int                     @unique @map("person_id")
  status              MembershipRequestStatus @default(PENDING)
  applicationData     Json                    @map("application_data") @db.JsonB
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  person     Person                       @relation(fields: [personId], references: [personId], onDelete: Restrict, onUpdate: NoAction)
  committees MembershipRequestCommittee[]
  globalRoles MembershipRequestGlobalRole[]

  @@map("membership_request")
}

model MembershipRequestCommittee {
  membershipRequestCommitteeId Int                        @id @default(autoincrement()) @map("membership_request_committee_id")
  membershipRequestId          Int                        @map("membership_request_id")
  committeeId                  Int                        @map("committee_id")
  requestedRole                String                     @map("requested_role") @db.VarChar(100)
  approvalScope                String                     @default("COMMITTEE") @map("approval_scope") @db.VarChar(32)
  status                       MembershipCommitteeDecision @default(PENDING)
  decidedByMemberId            Int?                       @map("decided_by_member_id")
  decidedAt                    DateTime?                  @map("decided_at") @db.Timestamptz(6)

  membershipRequest MembershipRequest @relation(fields: [membershipRequestId], references: [membershipRequestId], onDelete: Cascade, onUpdate: NoAction)
  committee         Committee         @relation(fields: [committeeId], references: [committeeId], onDelete: Restrict, onUpdate: NoAction)
  reviewer          Member?           @relation("MembershipDecisionReviewer", fields: [decidedByMemberId], references: [memberId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([membershipRequestId, committeeId])
  @@index([committeeId, status, membershipRequestId])
  @@map("membership_request_committee")
}

model MembershipRequestGlobalRole {
  membershipRequestGlobalRoleId Int                        @id @default(autoincrement()) @map("membership_request_global_role_id")
  membershipRequestId           Int                        @map("membership_request_id")
  roleCode                      String                     @map("role_code") @db.Text
  status                        MembershipCommitteeDecision @default(PENDING)
  decidedByMemberId             Int?                       @map("decided_by_member_id")
  decidedAt                     DateTime?                  @map("decided_at") @db.Timestamptz(6)

  membershipRequest MembershipRequest @relation(fields: [membershipRequestId], references: [membershipRequestId], onDelete: Cascade, onUpdate: NoAction)
  role              Role               @relation(fields: [roleCode], references: [roleCode], onDelete: Restrict, onUpdate: NoAction)
  reviewer          Member?            @relation("GlobalRoleDecisionReviewer", fields: [decidedByMemberId], references: [memberId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([membershipRequestId, roleCode])
  @@index([roleCode, status, membershipRequestId])
  @@map("membership_request_global_role")
}

model Announcement {
  announcementId      Int                  @id @default(autoincrement()) @map("announcement_id")
  slug                String               @unique @db.VarChar(255)
  title               String               @db.VarChar(200)
  excerpt             String               @db.VarChar(500)
  category            AnnouncementCategory
  status              AnnouncementStatus   @default(PUBLISHED)
  body                String?              @db.Text
  imageUrl            String?              @map("image_url") @db.VarChar(2048)
  actionLabel         String?              @map("action_label") @db.VarChar(80)
  actionHref          String?              @map("action_href") @db.VarChar(2048)
  pinned              Boolean              @default(false)
  publishedAt         DateTime             @default(now()) @map("published_at") @db.Timestamptz(6)
  publishedByMemberId Int                  @map("published_by_member_id")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  publisher Member @relation(fields: [publishedByMemberId], references: [memberId], onDelete: Restrict, onUpdate: NoAction)

  @@index([pinned, publishedAt])
  @@map("announcement")
}

model NonMemberRegistration {
  nonMemberRegistrationId Int      @id @default(autoincrement()) @map("non_member_registration_id")
  personId                Int      @unique @map("person_id")
  applicationData         Json     @map("application_data") @db.JsonB
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [personId], onDelete: Restrict, onUpdate: NoAction)

  @@map("non_member_registration")
}

model EmailVerificationChallenge {
  emailVerificationChallengeId Int       @id @default(autoincrement()) @map("email_verification_challenge_id")
  personId                     Int       @map("person_id")
  purpose                      String    @db.VarChar(32)
  email                        String    @db.VarChar(255)
  codeHash                     String    @map("code_hash") @db.VarChar(64)
  sentAt                       DateTime  @default(now()) @map("sent_at") @db.Timestamptz(6)
  expiresAt                    DateTime  @map("expires_at") @db.Timestamptz(6)
  attempts                     Int       @default(0)
  consumedAt                   DateTime? @map("consumed_at") @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [personId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([personId, purpose])
  @@index([expiresAt])
  @@map("email_verification_challenge")
}

model PendingSignup {
  pendingSignupId Int      @id @default(autoincrement()) @map("pending_signup_id")
  personId        Int      @unique @map("person_id")
  registrationType String  @map("registration_type") @db.VarChar(20)
  applicationData Json     @map("application_data") @db.JsonB
  committees      Json     @default("[]") @db.JsonB
  globalRoles     Json     @default("[]") @map("global_roles") @db.JsonB
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [personId], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt])
  @@map("pending_signup")
}

// Signup data stays here until the email verification code is accepted.
// There is deliberately no Person relation so unverified signups cannot
// appear as accounts in the application database.
model SignupVerification {
  signupVerificationId Int       @id @default(autoincrement()) @map("signup_verification_id")
  authUserId            String    @unique @map("auth_user_id") @db.Uuid
  fullName              String    @map("full_name") @db.VarChar(255)
  emailPersonal         String    @unique @map("email_personal") @db.VarChar(255)
  emailUniversity       String?   @map("email_university") @db.VarChar(255)
  registrationType      String    @map("registration_type") @db.VarChar(20)
  applicationData       Json      @map("application_data") @db.JsonB
  committees            Json      @default("[]") @db.JsonB
  globalRoles           Json      @default("[]") @map("global_roles") @db.JsonB
  codeHash              String?   @map("code_hash") @db.VarChar(64)
  sentAt                DateTime? @map("sent_at") @db.Timestamptz(6)
  codeExpiresAt         DateTime? @map("code_expires_at") @db.Timestamptz(6)
  attempts              Int       @default(0)
  verifiedAt            DateTime? @map("verified_at") @db.Timestamptz(6)
  expiresAt             DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("signup_verification")
}

model RevokedAuthToken {
  tokenHash String   @id @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime @default(now()) @map("revoked_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("revoked_auth_token")
}

model AuthRateLimitBucket {
  bucketHash      String   @id @map("bucket_hash") @db.VarChar(64)
  windowStartedAt DateTime @map("window_started_at") @db.Timestamptz(6)
  requestCount    Int      @default(1) @map("request_count")
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([windowStartedAt])
  @@map("auth_rate_limit_bucket")
}

model PersonEmailIdentity {
  personEmailIdentityId Int      @id @default(autoincrement()) @map("person_email_identity_id")
  personId              Int      @map("person_id")
  email                 String   @db.VarChar(255)
  kind                  String   @db.VarChar(20)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  person Person @relation(fields: [personId], references: [personId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([personId, kind])
  @@map("person_email_identity")
}

model CommitteeTask {
  taskId            Int      @id @default(autoincrement()) @map("task_id")
  committeeId       Int      @map("committee_id")
  title             String   @db.VarChar(150)
  description       String   @default("") @db.Text
  assignedMemberId  Int      @map("assigned_member_id")
  createdByMemberId Int      @map("created_by_member_id")
  dueAt             DateTime @map("due_at") @db.Timestamptz(3)
  priority          String   @default("MEDIUM") @db.VarChar(10)
  status            String   @default("TODO") @db.VarChar(20)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  committee Committee       @relation(fields: [committeeId], references: [committeeId], onDelete: Restrict, onUpdate: NoAction)
  assignee  MemberCommittee @relation("TaskAssignee", fields: [assignedMemberId, committeeId], references: [memberId, committeeId], onDelete: Restrict, onUpdate: NoAction)
  creator   MemberCommittee @relation("TaskCreator", fields: [createdByMemberId, committeeId], references: [memberId, committeeId], onDelete: Restrict, onUpdate: NoAction)

  @@index([committeeId, status, dueAt])
  @@index([assignedMemberId, committeeId, status])
  @@map("committee_task")
}

model CommitteePointEntry {
  pointEntryId      Int      @id @default(autoincrement()) @map("point_entry_id")
  committeeId       Int      @map("committee_id")
  memberId          Int      @map("member_id")
  awardedByMemberId Int      @map("awarded_by_member_id")
  pointsDelta       Int      @map("points_delta")
  reason            String   @db.VarChar(500)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  recipient MemberCommittee @relation("PointsRecipient", fields: [memberId, committeeId], references: [memberId, committeeId], onDelete: Restrict, onUpdate: NoAction)
  awarder   MemberCommittee @relation("PointsAwarder", fields: [awardedByMemberId, committeeId], references: [memberId, committeeId], onDelete: Restrict, onUpdate: NoAction)

  @@index([committeeId, createdAt, pointEntryId])
  @@index([memberId, committeeId, createdAt])
  @@map("committee_point_entry")
}

model Event {
  eventId                 Int         @id @default(autoincrement()) @map("event_id")
  name                    String      @db.VarChar(200)
  description             String?     @db.Text
  startsAt                DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt                  DateTime    @map("ends_at") @db.Timestamptz(3)
  location                String?     @db.VarChar(255)
  capacity                Int
  registrationDeadline    DateTime    @map("registration_deadline") @db.Timestamptz(3)
  confirmationWindowHours Int         @default(24) @map("confirmation_window_hours")
  imageUrl                String?     @map("image_url") @db.VarChar(255)
  requirements            String?     @db.Text
  eventType               String?     @map("event_type") @db.VarChar(30)
  speakers                String?     @db.Text
  mapsLink                String?     @map("maps_link") @db.VarChar(500)
  requiredRegistrantFields String[]   @default([]) @map("required_registrant_fields")
  status                  EventStatus @default(DRAFT)
  createdByMemberId       Int         @map("created_by_member_id")
  committeeId             Int         @map("committee_id")
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  creator       Member              @relation("EventCreator", fields: [createdByMemberId], references: [memberId], onDelete: Restrict, onUpdate: NoAction)
  committee     Committee           @relation(fields: [committeeId], references: [committeeId], onDelete: Restrict, onUpdate: Restrict)
  questions     EventQuestion[]
  registrations EventRegistration[]

  @@index([status, startsAt, eventId])
  @@index([status, endsAt, eventId])
  @@index([createdByMemberId, createdAt, eventId])
  @@index([committeeId, createdAt, eventId])
  @@map("events")
}

model EventQuestion {
  questionId   Int          @id @default(autoincrement()) @map("question_id")
  eventId      Int          @map("event_id")
  questionText String       @map("question_text") @db.Text
  questionType QuestionType @map("question_type")
  isRequired   Boolean      @default(false) @map("is_required")
  position     Int
  options      Json?        @db.JsonB

  event   Event                @relation(fields: [eventId], references: [eventId], onDelete: Cascade, onUpdate: Restrict)
  answers RegistrationAnswer[]

  @@unique([eventId, position])
  @@unique([questionId, eventId])
  @@map("event_questions")
}

model EventRegistration {
  registrationId           Int                @id @default(autoincrement()) @map("registration_id")
  eventId                  Int                @map("event_id")
  personId                 Int                @map("person_id")
  registeredAt             DateTime           @default(now()) @map("registered_at") @db.Timestamptz(3)
  status                   RegistrationStatus @default(PENDING)
  reviewedByMemberId       Int?               @map("reviewed_by_member_id")
  approvedAt               DateTime?          @map("approved_at") @db.Timestamptz(3)
  confirmationDeadline     DateTime?          @map("confirmation_deadline") @db.Timestamptz(3)
  confirmedAt              DateTime?          @map("confirmed_at") @db.Timestamptz(3)
  waitlistPosition         Int?               @map("waitlist_position")
  cancelledAt              DateTime?          @map("cancelled_at") @db.Timestamptz(3)
  excusedAt                DateTime?          @map("excused_at") @db.Timestamptz(3)
  excusedByMemberId        Int?               @map("excused_by_member_id")
  excuseReason             String?            @map("excuse_reason") @db.Text
  attendanceTokenHash      String?            @unique @map("attendance_token_hash") @db.Text
  attendanceTokenEncrypted String?            @map("attendance_token_encrypted") @db.Text
  checkedInAt              DateTime?          @map("checked_in_at") @db.Timestamptz(3)
  checkedInByMemberId      Int?               @map("checked_in_by_member_id")

  event            Event                        @relation(fields: [eventId], references: [eventId], onDelete: Restrict, onUpdate: Restrict)
  person           Person                       @relation("RegistrationOwner", fields: [personId], references: [personId], onDelete: Restrict, onUpdate: NoAction)
  reviewer         Member?                      @relation("RegistrationReviewer", fields: [reviewedByMemberId], references: [memberId], onDelete: Restrict, onUpdate: NoAction)
  checkInStaff     Member?                      @relation("RegistrationCheckInStaff", fields: [checkedInByMemberId], references: [memberId], onDelete: Restrict, onUpdate: NoAction)
  excuseStaff      Member?                      @relation("RegistrationExcuseStaff", fields: [excusedByMemberId], references: [memberId], onDelete: Restrict, onUpdate: NoAction)
  answers          RegistrationAnswer[]
  blacklistEntries RegistrationBlacklistEntry[]

  @@unique([eventId, personId])
  @@unique([registrationId, eventId])
  @@unique([eventId, waitlistPosition])
  @@index([personId, registeredAt, registrationId])
  @@index([eventId, status, registeredAt, registrationId])
  @@index([status, confirmationDeadline])
  @@index([reviewedByMemberId])
  @@index([checkedInByMemberId])
  @@index([excusedByMemberId])
  @@map("event_registrations")
}

model RegistrationAnswer {
  answerId       Int    @id @default(autoincrement()) @map("answer_id")
  registrationId Int    @map("registration_id")
  questionId     Int    @map("question_id")
  eventId        Int    @map("event_id")
  answerText     String @map("answer_text") @db.Text

  // Both foreign keys share eventId to prevent answers to another event's questions.
  registration EventRegistration @relation(fields: [registrationId, eventId], references: [registrationId, eventId], onDelete: Cascade, onUpdate: Restrict)
  question     EventQuestion     @relation(fields: [questionId, eventId], references: [questionId, eventId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([registrationId, questionId])
  @@index([questionId, eventId])
  @@map("registration_answers")
}

model RegistrationBlacklistEntry {
  entryId            Int             @id @default(autoincrement()) @map("entry_id")
  registrationId     Int             @map("registration_id")
  reason             BlacklistReason
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt         DateTime?       @map("resolved_at") @db.Timestamptz(3)
  resolvedByMemberId Int?            @map("resolved_by_member_id")
  resolutionReason   String?         @map("resolution_reason") @db.Text

  registration EventRegistration @relation(fields: [registrationId], references: [registrationId], onDelete: Restrict, onUpdate: Restrict)
  resolver     Member?           @relation("BlacklistResolver", fields: [resolvedByMemberId], references: [memberId], onDelete: Restrict, onUpdate: NoAction)

  @@unique([registrationId, reason])
  @@index([resolvedByMemberId])
  @@map("registration_blacklist_entries")
}

# Keep environment variables out of version control

# Dependencies
node_modules/

# Environment variables
.env
.env.*
!.env.example

# Build output
dist/

# TypeScript build info
*.tsbuildinfo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# Test coverage
coverage/
.nyc_output/

# IDE
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp

# Prisma local database files
prisma/*.db
prisma/*.db-journal
/src/generated/prisma

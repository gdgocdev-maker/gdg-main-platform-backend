# HTTP server
PORT=3001

# Local frontend origin permitted by CORS
FRONTEND_URL=http://localhost:3000
# Comma-separated additional exact frontend origins (for example, local UI access to a hosted API).
FRONTEND_ORIGINS=
# Number of trusted reverse-proxy hops in front of this API. Keep 0 for direct local access.
TRUST_PROXY_HOPS=0

# Local PostgreSQL. Replace the password in your ignored .env only.
# Keep it URL-safe (letters and numbers), or URL-encode it in DATABASE_URL.
POSTGRES_DB=gdg_platform
POSTGRES_USER=gdg_local
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# Used when running Prisma or the backend on the host. Match the values above.
# Docker Compose overrides this URL with the internal db hostname for the backend.
DATABASE_URL="postgresql://gdg_local:CHANGE_ME@localhost:5432/gdg_platform?schema=public"

# Local pgAdmin web login (separate from the PostgreSQL user/password).
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME
PGADMIN_PORT=5050

# Supabase Auth project that issues login tokens. The URL is not a secret.
# Protected requests fail until this points at a real project.
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# Publishable key: used for login and signup, safe to expose.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_CHANGE_ME
# Secret key: full admin access (invites, creating users). Real value goes in .env only.
SUPABASE_SECRET_KEY=sb_secret_CHANGE_ME
# Gmail SMTP sends the same signup verification code to personal and university emails.
# Use a Google App Password, not your normal Gmail password. Keep real values in .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-character-app-password
AUTH_EMAIL_FROM=GDG on Campus UJ <your-gmail@gmail.com>
# Frontend origin used to build the localized password setup link. Add both
# localized reset URLs to Supabase:
# Authentication > URL Configuration > Redirect URLs. In the Reset Password
# email templates, link to {{ .RedirectTo }}#token_hash={{ .TokenHash }} with
# type=recovery for Reset Password and type=invite for Invite user.
PASSWORD_SETUP_URL=http://localhost:3000

# Gmail API OAuth (future setup only; Gmail OAuth is not implemented yet).
# Keep the real values in the ignored backend .env file. Never commit them or
# place them in frontend/NEXT_PUBLIC_ variables. These correspond to the
# downloaded Google OAuth "web" client JSON fields.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3001/integrations/google/gmail/callback

# Full-platform development defaults to ../gdg-main-platform-frontend.
# For another location, export FRONTEND_PATH in your shell before ./gdg run.

# Encrypts stored attendance QR tokens (32 random bytes, base64). Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ATTENDANCE_TOKEN_KEY=CHANGE_ME

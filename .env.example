# HTTP server
PORT=3001

# Local frontend origin permitted by CORS
FRONTEND_URL=http://localhost:3000

# Local PostgreSQL. Replace the password in your ignored .env only.
# Keep it URL-safe (letters and numbers), or URL-encode it in DATABASE_URL.
POSTGRES_DB=gdg_platform
POSTGRES_USER=gdg_local
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# Used when running Prisma or the backend on the host. Match the values above.
# Docker Compose overrides this URL with the internal db hostname for the backend.
DATABASE_URL="postgresql://gdg_local:CHANGE_ME@localhost:5432/gdg_platform?schema=public"

# Local pgAdmin web login (separate from the PostgreSQL user/password).
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME
PGADMIN_PORT=5050

# HTTP server
PORT=3001

# Local frontend origin permitted by CORS
FRONTEND_URL=http://localhost:3000
# Comma-separated additional exact frontend origins (for example, local UI access to a hosted API).
FRONTEND_ORIGINS=
# Number of trusted reverse-proxy hops in front of this API. Keep 0 for direct local access.
TRUST_PROXY_HOPS=0

# Local PostgreSQL. Replace the password in your ignored .env only.
# Keep it URL-safe (letters and numbers), or URL-encode it in DATABASE_URL.
POSTGRES_DB=gdg_platform
POSTGRES_USER=gdg_local
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# Used when running Prisma or the backend on the host. Match the values above.
# Docker Compose overrides this URL with the internal db hostname for the backend.
DATABASE_URL="postgresql://gdg_local:CHANGE_ME@localhost:5432/gdg_platform?schema=public"

# Local pgAdmin web login (separate from the PostgreSQL user/password).
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME
PGADMIN_PORT=5050

# Supabase is retained for event-image Storage only (server credentials).
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_SECRET_KEY=sb_secret_CHANGE_ME

# Existing non-auth event/membership notifications still use SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=CHANGE_ME
AUTH_EMAIL_FROM=GDG on Campus UJ <your-gmail@gmail.com>

# Full-platform development defaults to ../gdg-main-platform-frontend.
# For another location, export FRONTEND_PATH in your shell before ./gdg run.

# Encrypts stored attendance QR tokens (32 random bytes, base64). Generate your own:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ATTENDANCE_TOKEN_KEY=CHANGE_ME
# Optional owner-issued Wallet integration credentials. Both values are required to enable projection.
WALLET_PROJECTION_URL=
WALLET_PROJECTION_TOKEN=
# Separate scoped credential for the owner worker to pull guest passes and claim their email deliveries.
WALLET_GUEST_WORKER_TOKEN=
WALLET_GUEST_COMMITTEES=

# Optional outbound guest pass queue. Set both, and use WALLET_GUEST_COMMITTEES above.
WALLET_GUEST_RELAY_ORIGIN=
WALLET_GUEST_RELAY_TOKEN=
# Public origin used in guest Wallet buttons if it differs from the relay origin.
WALLET_GUEST_PUBLIC_ORIGIN=

# Better Auth migration (backend only; never expose these to browser bundles)
BETTER_AUTH_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
RESEND_API_KEY=re_CHANGE_ME
EMAIL_FROM="GDG on Campus UJ <noreply@gdguj.org>"
# Optional owner-controlled inbox for the explicitly requested live delivery test.
EMAIL_TEST_TO=
